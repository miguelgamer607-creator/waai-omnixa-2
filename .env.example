# For Docker/server deployments, replace this with a long random secret.
# Never commit your real .env file to GitHub.
WAAI_ACCESS_TOKEN=replace-with-a-long-random-secret
APP_ENV=production
DB_PATH=/data/waai.db

# Autonomous reminders and reports use this time zone.
WAAI_TIMEZONE=America/Bogota
WAAI_DAILY_REPORT_HOUR=5
WAAI_AUTOMATION_INTERVAL_SECONDS=60

# Web search runs only after an explicit research assignment. Set false to disable it.
WAAI_RESEARCH_ENABLED=true
WAAI_RESEARCH_TIMEOUT_SECONDS=10

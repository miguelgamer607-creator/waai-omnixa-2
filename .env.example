# Private token: replace with a long random secret, never commit a real .env file.
WAAI_ACCESS_TOKEN=replace-with-a-long-random-secret
APP_ENV=production
DB_PATH=/data/waai.db

WAAI_TIMEZONE=America/Bogota
WAAI_DAILY_REPORT_HOUR=5
WAAI_AUTOMATION_INTERVAL_SECONDS=60

# Web research: only user-authorized topics. Automatic research is off by default.
WAAI_RESEARCH_ENABLED=true
WAAI_RESEARCH_TIMEOUT_SECONDS=10
WAAI_AUTONOMY_MODE=off
WAAI_RESEARCH_INTERESTS=
WAAI_AUTONOMY_RESEARCH_HOUR=6
WAAI_SHIMEJI_COOLDOWN_MINUTES=240

# Optional OpenAI-compatible chat completion provider. Keep credentials server-side.
WAAI_LLM_BASE_URL=
WAAI_LLM_MODEL=
WAAI_LLM_API_KEY=
WAAI_LLM_TIMEOUT_SECONDS=45
WAAI_LLM_TEMPERATURE=0.7
WAAI_LLM_MAX_TOKENS=700
